{
  "expo": {
    "name": "Bible Threads",
    "slug": "bible-threads",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.timberlake.biblethreads",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.timberlake.biblethreads"
    },
    "extra": {
      "eas": {
        "projectId": "3f37a961-1471-42e9-b03c-bcff840fea25"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#fbfbfa",
          "enableFullScreenImage_legacy": true
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
